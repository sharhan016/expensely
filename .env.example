POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_analyzer
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_analyzer
SESSION_SECRET=replace-with-a-long-random-value
UPLOAD_DIR=./storage/statements
NEXT_PUBLIC_API_URL=http://localhost:8000

# End-to-end tests keep a shared signed-in account in a git-ignored .env.e2e at the repo root
# (E2E_EMAIL, E2E_PASSWORD, E2E_NAME). The Playwright setup creates it with a random password.
